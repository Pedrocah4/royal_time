<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_hud"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Círculo Customizado do Contador de Elixir -->
    <com.example.royaltime.ElixirCircleView
        android:id="@+id/elixir_circle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Botão de Fechar Redondo Super Discreto (18dp) -->
    <TextView
        android:id="@+id/btn_close"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/close_button_background"
        android:gravity="center"
        android:text="✕"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

</FrameLayout>
